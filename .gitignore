__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# macOS / IDE
.DS_Store
.specstory/
.cursorindexingignore

# Large derived artifacts (reproducible from source, synced via Dropbox)
# Dataset JSONs
artifacts/*/mc_dataset.json
artifacts/*/train_dataset.json
artifacts/*/val_dataset.json
artifacts/*/test_dataset.json
# Per-episode trace files (tens of MB each)
artifacts/*/baseline_*_runs.json
artifacts/*/ppo_runs.json
# Model files
artifacts/*/ppo_model.zip
# Answer profiles (derived from dataset)
artifacts/*/answer_profiles.json
# Exclude all non-smoke artifact directories entirely;
# smoke/ is small enough to serve as CI reference output
artifacts/main/
artifacts/k[0-9]*/
artifacts/distractor_*/

# Full-run results (reproducible, kept locally via Dropbox)
results/*.log
results/*.zip

# Model checkpoints and training state (synced via Dropbox, not git)
checkpoints/

# One-off forensic artifact: actor-critic file-triage workspace from the
# 2026-05-13 Dropbox-conflict cleanup. Preserved locally as an evidence
# trail; not reusable tooling.
.cleanup-assessment/

# Large UTF-16 stdout dump from the 2026-03-17 Mode-A run. GitHub will not
# render or diff it usefully; archived externally and referenced by SHA-256
# in results/GENERATED_FILES_MANIFEST.md instead.
results/phase_8_sweep.txt

# Archived artifact directories from fresh-split protocol (v10 section 0.3)
# These are preserved on disk (Dropbox sync) but too large for git
artifacts.pre_v10_freshsplit_*/
data/processed.pre_v10_freshsplit_*/
.claude/
